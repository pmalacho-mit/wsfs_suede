                }
              }
            }
          }
        }
      }
    },
    "/wsfs/workspaces/{workspace_id}/stream": {
      "get": {
        "summary": "Events",
        "description": "The token is the credential here -- EventSource cannot carry a\nheader, which is why it is single-use and position-bound.",
        "operationId": "events_wsfs_workspaces__workspace_id__stream_get",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One `data:` line per event, in position order, and a `: hb` comment every heartbeat. Declared here because this payload is what a client's confirmed map is mutated by -- an undeclared one could not be generated.",
            "content": {
              "text/event-stream": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
