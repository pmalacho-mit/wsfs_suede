    "/wsfs/workspaces/{workspace_id}/blobs/{digest}": {
      "put": {
        "summary": "Store",
        "description": "Under a workspace because that is the only question a host's\n`authorize` can answer -- which is also why the id appears in the path\nand not in this signature: the host's dependency is what reads it. The\nbytes themselves are stored once for the deployment and named by their\nhash -- two workspaces holding the same file hold one copy -- but\nsomebody who may reach no workspace at all may not fill the\ndeployment's disk either.",
        "operationId": "store_wsfs_workspaces__workspace_id__blobs__digest__put",
        "parameters": [
          {
            "name": "digest",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Digest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Fetch Blob",
        "description": "Served only to a workspace that WRITES these bytes somewhere.\n\nA hash is not a secret: it travels in `X-Content-Hash`, in every\n`BinaryBody`, and through any client that ever held the file. So\nknowing one buys nothing here -- the caller has to be someone the host\nlets into a workspace whose own content log names it.",
        "operationId": "fetch_blob_wsfs_workspaces__workspace_id__blobs__digest__get",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Workspace Id"
            }
          },
          {
            "name": "digest",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Digest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/wsfs/workspaces/{workspace_id}/entries/{entry_id}/content": {
      "get": {
        "summary": "Content",
        "description": "Omitting `content` asks for the entry's newest.",
        "operationId": "content_wsfs_workspaces__workspace_id__entries__entry_id__content_get",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
